# ===========================================================================
# BERKAS INI UNTUK PIPELINE SAJA (dijalankan lokal, tidak pernah di-deploy).
#
# Salin jadi `.env` lalu isi. Jangan mengisi berkas .example ini — ia dilacak
# git dan harus tetap kosong.
#
# Kunci frontend TIDAK ada di sini. Lihat web/.env.example.
# ===========================================================================

# MAPID Activities API (158 foto survei)
MAPID_API_KEY_MISSION=

# MAPID Open API layer geoserver
MAPID_API_KEY_DATA=
MAPID_PROJECT_ID=

# Google Earth Engine, untuk W2 keteduhan (NDVI Sentinel-2)
EE_PROJECT=
