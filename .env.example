# Kunci untuk PIPELINE (Python, dijalankan offline).
# Salin berkas ini menjadi `.env` di akar repo, lalu isi nilainya.
# Kunci frontend terpisah, ada di web/.env.example.

# MAPID Activities API, dipakai 00_ingest/04_activities.py untuk mengambil
# dokumentasi survei lapangan.
MAPID_API_KEY_MISSION=

# Google Earth Engine, dipakai 30_indicators/05_w2_keteduhan.py untuk menghitung
# NDVI dari Sentinel-2. Jalankan `earthengine authenticate` sekali sebelumnya.
EE_PROJECT=
