# ===========================================================================
# BERKAS INI UNTUK FRONTEND SAJA.
#
# Lokal : salin jadi `web/.env` lalu isi.
# Vercel: isi di Settings > Environment Variables, JANGAN lewat berkas.
#
# Kunci pipeline TIDAK ada di sini, ada di ../.env
# ===========================================================================

# Basemap MAPID MAPS. Boleh sampai ke browser.
VITE_MAPID_BASEMAP_KEY=

# Opsional: URL style MapLibre publik. Kalau diisi, ia MENGGANTIKAN basemap
# MAPID dan kunci di atas tidak dipakai. Berguna untuk mencoba tanpa kunci.
# Lihat web/src/lib/basemap.js.
VITE_BASEMAP_STYLE_URL=

# DeepSeek, untuk AI-1/2/4. HANYA sisi server.
# JANGAN diberi awalan VITE_ — Vite menyisipkan semua VITE_* ke bundel browser,
# jadi awalan itu akan menerbitkan kuncimu ke setiap pengunjung.
DEEPSEEK_API_KEY=
