docs/SURVEI_ANOMALI.md
docs/MAPID_EXPORT_LIST.md
docs/MAPID_PENGGUNAAN.md
docs/MAPID_UNDUH.md

# berkas kerja sementara di akar
kos_koordinat_untuk_dicek.csv
kos_pengganti_isian.xlsx
mapid_data.txt

# skrip uji sekali pakai
web/_*.mjs
web/test-results/


# data survei dan turunan MAPID Activities (ketentuan kompetisi)
