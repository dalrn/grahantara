*.parquet
*.graphml
*.gpkg

# rahasia
.env
.env.*
!.env.example

# python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# node
node_modules/
dist/
.vercel/

# os
.DS_Store

# artefak ingest yang besar (cache, bisa diunduh ulang)
data/*.tif
*.osm.pbf

# cache unduhan osmnx/overpass
cache/
