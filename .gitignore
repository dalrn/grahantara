# data mentah dan antara - jangan pernah di-commit
# Seluruh isi data/ diabaikan, bukan hanya subfolder. Sebelumnya hanya tiga
# subfolder yang tercakup, sehingga berkas yang jatuh di akar data/ lolos dan
# sempat ter-commit ke GitHub. reference/ adalah tempat masukan hasil kurasi
# tangan yang memang dilacak git.
# Awalan "/" mengikat pola ke akar repo. Tanpa itu, "data/" juga cocok dengan
# web/public/data/ yang justru HARUS di-commit karena itu keluaran yang disajikan
# frontend.
/data/
!/data/README.md
*.parquet
*.graphml
*.gpkg

# rahasia
.env
.env.*
!.env.example

# python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# node
node_modules/
dist/
.vercel/

# os
.DS_Store

# artefak ingest yang besar (cache, bisa diunduh ulang)
data/*.tif
*.osm.pbf

# cache unduhan osmnx/overpass
cache/

# data MAPID, jangan commit (ketentuan kompetisi)
reference/mapid/

# catatan kerja internal: tidak ikut dipublikasikan
CLAUDE.md
web/CLAUDE.md
web/UI_UX_NOTES.md
docs/ARCHITECTURE.md
